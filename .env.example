# ======================================================
# .env.example — Template des variables d'environnement
# ======================================================
# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Le fichier ".env" NE DOIT PAS être commité sur GitHub.

# Token ENTSO-E Transparency Platform
# Obtenez le vôtre sur : https://transparency.entsoe.eu/
ENTSOE_TOKEN=your_entsoe_api_token_here

# Code de propriété Nuuka (API Helsinki Open Data)
# Format : XXX-XXX-XXXX-XXXX
OODI_CODE=your_oodi_property_code_here
